{
	"instance": "asc-odm",
	"odm_path": "/code",

	"logger": {
		"level": "info",
		"maxFileSize": 104857600,
		"maxFiles": 10,
		"logDirectory": "/var/log/nodeodm"
	},

	"port": 3000,
	"deamon": false,
	"parallelQueueProcessing": 2,
	"cleanupTasksAfter": 1440,
	"cleanupUploadsAfter": 1440,
	"test": false,
	"token": "",
	"authorizedIps": [],
	"maxImages": "",

	"_comment_gcs": "GCS Configuration - Set gcsBucket to enable GCS uploads",
	"gcsBucket": "your-gcs-bucket-name",
	"gcsProjectId": "your-gcp-project-id",
	"gcsKeyPath": "/path/to/service-account-key.json",
	"gcsParallelUploads": 16,
	"gcsUploadPaths": "odm_orthophoto,odm_dem,odm_report,odm_georeferencing,odm_meshing,odm_texturing,odm_texturing_25d,odm_filterpoints,3d_tiles,orthophoto_tiles,rtk_analysis,cameras.json,images.json,img_list.txt,log.json,options.json,task_output.txt,benchmark.txt",
	"gcsCleanupAfterUpload": true,
	"gcsSkipLocalArchive": false,

	"_comment_s3": "S3 Configuration - Leave empty if using GCS",
	"s3Endpoint": "",
	"s3Bucket": "",
	"s3AccessKey": "",
	"s3SecretKey": ""
}

