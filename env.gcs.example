# Optional Google Cloud Storage (add these to .env for local dev)
#
# On staging/production the container only needs --gcs_bucket (see deploy-staging.yml).
# The GCE VM service account provides credentials automatically — no JSON key, no WIF
# inside the running NodeODM process. (WIF in GitHub Actions is only for CI deploy.)
#
# Local Docker: set bucket + prefix below, then authenticate with Application Default
# Credentials (recommended):
#   gcloud auth application-default login
#   docker compose -f docker-compose.dev.yml -f docker-compose.gcs-adc.yml up --build
#
# Optional: docker-compose.gcs.yml mounts a service-account JSON instead of ADC.

GCS_BUCKET=nodeodm-outputs-v1
GCS_PROJECT_ID=tools-471222
GCS_UPLOAD_PREFIX=outputs
